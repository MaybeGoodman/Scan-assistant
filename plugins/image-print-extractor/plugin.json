{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "image-print-extractor",
  "version": "0.1.0",
  "description": "提取图片印刷体，忽略手写，保留 LaTeX、真实表格及 PNG 插图。",
  "author": {
    "name": "MaybeGoodman"
  },
  "repository": "https://github.com/MaybeGoodman/Scan-assistant",
  "keywords": [
    "ocr",
    "printed-text",
    "latex",
    "education",
    "chinese"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "图片印刷体提取",
        "shortDescription": "忽略手写，提取印刷内容、公式、表格和插图",
        "longDescription": "从教材、试题、讲义和扫描图片中提取印刷内容，排除手写及页眉页脚，规范中文标点和 LaTeX，按原顺序输出文字、可编辑 HTML 表格及 PNG 插图。",
        "developerName": "MaybeGoodman",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "提取图片中的印刷内容，忽略手写，保留公式、表格和插图。"
        ],
        "brandColor": "#F4B875",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "image-print-extractor",
  "version": "0.2.0",
  "description": "提取图片和 PDF 印刷体，清除无关水印，确认后输出可编辑 Word。",
  "author": {
    "name": "MaybeGoodman"
  },
  "repository": "https://github.com/MaybeGoodman/Scan-assistant",
  "keywords": [
    "ocr",
    "printed-text",
    "latex",
    "education",
    "chinese"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "图片印刷体提取",
        "shortDescription": "图片与 PDF 印刷体提取，去除无关水印，可输出 Word",
        "longDescription": "从图片或 PDF 提取印刷内容，排除手写、页眉页脚及确定无关的水印与杂文字，保留公式、表格和插图。PDF 输入先明确输出格式，确认后整理为可编辑 Word 文档，接回可靠的断行和跨页续句。",
        "developerName": "MaybeGoodman",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "提取图片中的印刷内容，忽略手写，保留公式、表格和插图。",
          "把 PDF 的印刷内容整理成 Word，去除无关水印和杂文字。"
        ],
        "brandColor": "#F4B875",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}

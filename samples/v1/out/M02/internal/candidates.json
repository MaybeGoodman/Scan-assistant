    {
      "type": "text",
      "id": "ans2",
      "runs": [
        {
          "type": "text",
          "text": "【解析】"
        },
        {
          "type": "math",
          "latex": "U=IR_1+U_2=3\\,\\mathrm{V}+3\\,\\mathrm{V}=6\\,\\mathrm{V}"
        },
        {
          "type": "text",
          "text": "。"
        }
      ],

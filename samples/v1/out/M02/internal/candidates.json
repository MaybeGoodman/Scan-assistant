      }
    },
    {
      "type": "text",
      "id": "s1",
      "runs": [
        {
          "type": "text",
          "text": "（1）求电源电压"
        },
        {
          "type": "math",
          "latex": "U"
        },
        {
          "type": "text",
          "text": "；"
        }
      ],
      "role": "subquestion",
      "source": {
        "page": 1,
        "bbox": [
          90,
          648,
          1150,
          706
        ]
      },
      "selection": {
        "category": "MAIN_CONTENT",
        "relation": "main",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "s2",
      "runs": [
        {
          "type": "text",
          "text": "（2）求电阻"
        },
        {
          "type": "math",
          "latex": "R_2"
        },
        {
          "type": "text",
          "text": "的阻值；"
        }
      ],
      "role": "subquestion",
      "source": {
        "page": 1,
        "bbox": [
          90,
          706,
          1150,
          769
        ]
      },
      "selection": {
        "category": "MAIN_CONTENT",
        "relation": "main",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "s3",
      "runs": [
        {
          "type": "text",
          "text": "（3）若将"
        },
        {
          "type": "math",
          "latex": "R_2"
        },
        {
          "type": "text",
          "text": "换成阻值为"
        },
        {
          "type": "math",
          "latex": "20\\,\\Omega"
        },
        {
          "type": "text",
          "text": "的电阻"
        },
        {
          "type": "math",
          "latex": "R_3"
        },
        {
          "type": "text",
          "text": "，求此时电流表的示数。"
        }
      ],
      "role": "subquestion",
      "source": {
        "page": 1,
        "bbox": [
          90,
          769,
          1150,
          832
        ]
      },
      "selection": {
        "category": "MAIN_CONTENT",
        "relation": "main",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "ans1",
      "runs": [
        {
          "type": "text",
          "text": "【答案】（1）"
        },
        {
          "type": "math",
          "latex": "6\\,\\mathrm{V}"
        },
        {
          "type": "text",
          "text": "；（2）"
        },
        {
          "type": "math",
          "latex": "10\\,\\Omega"
        },
        {
          "type": "text",
          "text": "；（3）"
        },
        {
          "type": "math",
          "latex": "0.2\\,\\mathrm{A}"
        },
        {
          "type": "text",
          "text": "。"
        }
      ],
      "role": "answer",
      "source": {
        "page": 1,
        "bbox": [

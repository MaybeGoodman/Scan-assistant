      }
    },
    {
      "type": "text",
      "id": "stem1",
      "runs": [
        {
          "type": "text",
          "text": "21．如图所示电路，电源电压保持不变，定值电阻"
        },
        {
          "type": "math",
          "latex": "R_1=10\\,\\Omega"
        },
        {
          "type": "text",
          "text": "。闭合开关"
        },
        {
          "type": "math",
          "latex": "S"
        },
        {
          "type": "text",
          "text": "，电流表示数为"
        },
        {
          "type": "math",
          "latex": "0.3\\,\\mathrm{A}"
        },
        {
          "type": "text",
          "text": "，电压表示数为"
        },
        {
          "type": "math",
          "latex": "3\\,\\mathrm{V}"
        },
        {
          "type": "text",
          "text": "。"
        }
      ],
      "role": "stem",
      "source": {
        "page": 1,
        "bbox": [
          90,

    {
      "type": "text",
      "id": "stem1",
      "runs": [
        {
          "type": "text",
          "text": "15．一辆小车从静止开始做匀加速直线运动，加速度"
        },
        {
          "type": "math",
          "latex": "a_1=2\\,\\mathrm{m/s^2}"
        },
        {
          "type": "text",
          "text": "，经过"
        },
        {
          "type": "math",
          "latex": "4\\,\\mathrm{s}"
        },
        {
          "type": "text",
          "text": "后改做匀速直线运动，匀速运动〔6〕"
        },
        {
          "type": "math",
          "latex": "\\,\\mathrm{s}"
        },
        {
          "type": "text",
          "text": "后开始做匀减速直线运动，再经过"
        },
        {
          "type": "math",
          "latex": "2\\,\\mathrm{s}"
        },
        {
          "type": "text",
          "text": "恰好停止。"
        }
      ],
      "role": "stem",
      "source": {
        "page": 1,
        "bbox": [

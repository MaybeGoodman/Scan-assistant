        "relation": "main",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "stem1",
      "runs": [
        {
          "type": "text",
          "text": "19．已知函数"
        },
        {
          "type": "math",
          "latex": "f(x)=x^2-2ax+3"
        },
        {
          "type": "text",
          "text": "，"
        },
        {
          "type": "math",
          "latex": "a\\in\\mathbf{R}"
        },
        {
          "type": "text",
          "text": "。"
        }
      ],
      "role": "stem",
      "source": {
        "page": 1,
        "bbox": [
          90,
          201,
          1150,
          261
        ]
      },
      "selection": {
        "category": "MAIN_CONTENT",
        "relation": "main",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "s1",
      "runs": [
        {
          "type": "text",
          "text": "（1）若"
        },
        {
          "type": "math",
          "latex": "f(1)=0"
        },
        {
          "type": "text",
          "text": "，求"
        },
        {
          "type": "math",
          "latex": "a"
        },
        {
          "type": "text",
          "text": "的值；"
        }
      ],
      "role": "subquestion",
      "source": {
        "page": 1,
        "bbox": [
          90,
          261,
          1150,
          319
        ]
      },
      "selection": {
        "category": "MAIN_CONTENT",
        "relation": "main",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "s2",
      "runs": [
        {
          "type": "text",
          "text": "（2）在（1）的条件下，求"
        },
        {
          "type": "math",
          "latex": "f(x)"
        },
        {
          "type": "text",
          "text": "在区间"
        },
        {
          "type": "math",
          "latex": "[0,3]"
        },
        {
          "type": "text",
          "text": "上的最大值和最小值；"
        }
      ],
      "role": "subquestion",
      "source": {
        "page": 1,
        "bbox": [
          90,
          319,
          1150,
          377
        ]
      },
      "selection": {
        "category": "MAIN_CONTENT",
        "relation": "main",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "s3",
      "runs": [
        {
          "type": "text",
          "text": "（3）若"
        },
        {
          "type": "math",
          "latex": "f(x)\\geq 0"
        },
        {
          "type": "text",
          "text": "对任意"
        },
        {
          "type": "math",
          "latex": "x\\in[1,2]"
        },
        {
          "type": "text",
          "text": "恒成立，求实数"
        },
        {
          "type": "math",
          "latex": "a"
        },
        {
          "type": "text",
          "text": "的取值范围。"
        }
      ],
      "role": "subquestion",
      "source": {
        "page": 1,
        "bbox": [
          90,
          377,
          1150,
          434
        ]
      },
      "selection": {
        "category": "MAIN_CONTENT",
        "relation": "main",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "ans1",
      "runs": [
        {
          "type": "text",
          "text": "【答案】（1）"
        },
        {
          "type": "math",
          "latex": "a=2"
        },
        {
          "type": "text",
          "text": "；（2）最大值"
        },
        {
          "type": "math",
          "latex": "3"
        },
        {
          "type": "text",
          "text": "，最小值"
        },
        {
          "type": "math",
          "latex": "-1"
        },
        {
          "type": "text",
          "text": "；（3）"
        },
        {
          "type": "math",
          "latex": "a\\leq\\sqrt{3}"
        },
        {
          "type": "text",
          "text": "。"
        }
      ],
      "role": "answer",
      "source": {
        "page": 1,
        "bbox": [
          90,
          434,
          1150,
          492
        ]
      },
      "selection": {
        "category": "SUPPORTING_CONTENT",
        "relation": "supporting",
        "certainty": "high"
      }
    },
    {
      "type": "text",
      "id": "ans2",
      "runs": [
        {
          "type": "text",
          "text": "【解析】（3）分离参数得"
        },
        {
          "type": "math",
          "latex": "2a\\leq x+\\frac{3}{x}"
        },
        {
          "type": "text",
          "text": "，在"
        },
        {
          "type": "math",
          "latex": "x=\\sqrt{3}"
        },
        {
          "type": "text",
          "text": "处取最小值"
        },
        {
          "type": "math",
          "latex": "2\\sqrt{3}"
        },
        {
          "type": "text",
          "text": "。"
        }
      ],
      "role": "analysis",
      "source": {
        "page": 1,
        "bbox": [
